# 部署子路径，需与 App 租户配置里的 h5.operationUrl / h5.revenueUrl 一致
VITE_BASE_PATH=/mop-saas/

# 腾讯地图 JS API（GL）的 key，订单轨迹地图用。
# 注意这和 Android 侧 local.properties 里的 ops.map.tencentKey 是**两个不同的 key**：
# 腾讯位置服务控制台里 Android SDK 和 WebServiceAPI/JSAPI 是两类应用，不能混用。
# 这个 key 会打进前端产物，靠控制台的域名 Referer 白名单约束，别指望它保密。
VITE_TENCENT_MAP_JS_KEY=

# 本地调试用的兜底参数。生产由 App 通过 URL query 注入，这里留空即可。
# 注意：切勿把真实 signSecret / businessSecret 提交进仓库。
VITE_DEV_API_HOST=
VITE_DEV_TENANT_ID=
VITE_DEV_SIGN=
VITE_DEV_TENANT_SECRET=
VITE_DEV_ACCESS_TOKEN=
VITE_DEV_REFRESH_TOKEN=
